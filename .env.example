# ─── Scapia Itinerary — environment variables ───────────────────────────────
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# NEVER commit real keys.

# LOCAL DEV ONLY (npm run dev): read in the browser via import.meta.env.
# Used only when running Vite locally — the key stays on your machine and is
# NOT shipped to production (production uses the serverless function below).
VITE_OPENAI_API_KEY=your_openai_api_key_here

# PRODUCTION (Vercel) + `vercel dev`: SERVER-SIDE ONLY — never exposed to the
# browser. Set this in the Vercel dashboard:
#   Project → Settings → Environment Variables → add OPENAI_API_KEY
# Do NOT set VITE_OPENAI_API_KEY in Vercel (that would inline it into the
# public client bundle).
OPENAI_API_KEY=your_openai_api_key_here
